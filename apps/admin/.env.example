# Copy to .env for local dev. In production these are Fly secrets.

# Public origin of this app; must match a callback URL registered on the GitHub App
APP_URL=http://localhost:4100

# At least 32 chars, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# GitHub App (Settings → Developer settings → GitHub Apps). Install it on both
# repos below with the Contents (write) repository permission.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents; in .env use a quoted multi-line value or "\n" escapes
GITHUB_APP_PRIVATE_KEY=

# Public site repo that published posts are committed to (default: andersr/personal-site)
# GITHUB_REPO=andersr/personal-site

# Private repo holding drafts, as drafts/<slug>/index.mdx; needs an initial commit
DRAFTS_REPO=

# Numeric GitHub user ID allowed to sign in: `gh api user --jq .id`
ADMIN_GITHUB_USER_ID=

# Anthropic API key for the post-drafting agent
ANTHROPIC_API_KEY=

# Model the agent writes with (default: claude-opus-5-5)
# POST_AGENT_MODEL=claude-opus-5-5

# Optional "Full preview": a Vercel build of the site's `preview` branch that
# includes drafts. Set both, or neither to hide the button. Also needs, on the
# Vercel project: Preview-scoped DRAFTS_REPO and DRAFTS_REPO_TOKEN (a
# fine-grained PAT with read-only Contents on the drafts repo), Deployment
# Protection on, and a deploy hook for the `preview` branch.
# VERCEL_PREVIEW_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/...
# PREVIEW_SITE_URL=https://<project>-git-preview-<team>.vercel.app
