{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "preview": "pnpm --filter site preview",
    "astro": "pnpm --filter site astro",
    "admin:dev": "pnpm --filter admin dev",
    "admin:deploy": "fly deploy . --config apps/admin/fly.toml --dockerfile apps/admin/Dockerfile",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "checks": "pnpm -r run checks",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  },
  "engines": {
    "node": "24.x"
  }
}
